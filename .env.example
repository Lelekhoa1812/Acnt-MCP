# --- Server -----------------------------------------------------------------
ACNT_SERVER_NAME=acnt-mcp
ACNT_SERVER_VERSION=2.0.0
ACNT_PORT=80
ACNT_API_PREFIX=/api/v1
ACNT_LOG_LEVEL=info
# ACNT_PUBLIC_BASE_URL=https://acnt.example.com

# --- Redis (used for tool response caching) ---------------------------------
ACNT_REDIS_URL=redis://localhost:6379
ACNT_CACHE_TTL_SECONDS=300
# Set to false to require Redis at startup. Default true falls back to in-memory.
ACNT_REDIS_FALLBACK_ENABLED=true

# --- FX (Exchange Rates) ----------------------------------------------------
# Get a key at https://exchangeratesapi.io / https://apilayer.com
EXCHANGE_RATE_API=

# --- Accounting (Open Collective) -------------------------------------------
# Generate a Personal Access Token at https://opencollective.com/dashboard/settings/applications
# with the 'expenses' scope to enable accounting_expense_workflow.
OPENCOLLECTIVE_GRAPHQL_URL=https://api.opencollective.com/graphql/v2
OPENCOLLECTIVE_PAT_TOKEN=
OPENCOLLECTIVE_CLIENT_ID=
OPENCOLLECTIVE_CLIENT_SECRET=

# --- MCP transport ----------------------------------------------------------
ACNT_MCP_PATH=/mcp
ACNT_MCP_STATELESS=false
ACNT_MCP_JSON_RESPONSE=false
ACNT_MCP_COMPACT_ENVELOPE=true
ACNT_MCP_RETRY_INTERVAL_MS=2500
ACNT_MCP_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Comma-separated allowlist for the streamable HTTP MCP transport.
# ACNT_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# ACNT_MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
