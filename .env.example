AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-foundry-key
AZURE_AI_FOUNDRY_MODEL=gpt-5.4-mini
AZURE_AI_FOUNDRY_SLM=gpt-5-nano
AZURE_AI_FOUNDRY_TIMEOUT_MS=60000

EXCHANGE_RATE_API=your-exchangeratesapi-key
OPEN_WEATHER_API=your-openweather-key
NEWS_API=your-newsapi-key

HTH_SERVER_NAME=hth-stock-intelligence
HTH_SERVER_VERSION=1.0.0
HTH_TRANSPORT=http
HTH_PORT=80
HTH_API_PREFIX=/api/v1
HTH_LOG_LEVEL=debug
HTH_PUBLIC_BASE_URL=https://your-public-app-host

HTH_DATA_SOURCE=harmonise
LOCAL_HARMONISE=false
LOCAL_HARMONISE_ENDPOINT=http://localhost:9000

CLOUD_HARMONISE_ENDPOINT=https://your-harmonise-api-host
CLOUD_HARMONISE_API=your-harmonise-product-api-key
CLOUD_HARMONISE_IMAGE=https://your-image-host

# Optional additional request headers in JSON map form.
HTH_HARMONISE_HEADERS={}
HTH_MCP_BEARER_TOKEN=your-bearer-token
HTH_MCP_ALLOWED_HOSTS=your-public-app-host
HTH_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
HTH_MCP_OAUTH_ENABLED=true
HTH_MCP_OAUTH_TOKEN_TTL_SECONDS=3600
AUTO_TRUSTED_DOMAINS=chatgpt.com,claude.ai,claude.com

# Optional Zero Trust identity-aware gateway (Entra-style JWT claims enforcement).
HTH_IDENTITY_AUTH_ENABLED=false
HTH_AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
HTH_AUTH_AUDIENCE=api://<mcp-app-client-id>/MCP.Invoke
HTH_AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# Local test only; do not use in production.
HTH_AUTH_JWT_HS256_SECRET=
HTH_AUTH_REQUIRED_GROUP=MCP_Users
HTH_AUTH_REQUIRED_CLAIMS=tid,oid
HTH_AUTH_DEPARTMENT_CLAIMS=extension_departmentId,extension_department,officeLocation
HTH_AUTH_REQUIRED_TOKEN_VERSION=2.0
HTH_AUTH_RATE_LIMIT_PER_MINUTE=50


HTH_HARMONISE_TIMEOUT_MS=0
HTH_HARMONISE_RETRY_ATTEMPTS=3
HTH_HARMONISE_RETRY_BACKOFF_MS=1000
HTH_HARMONISE_RETRY_BACKOFF_CAP_MS=5000

HTH_REDIS_URL=redis://localhost:6379
HTH_CACHE_TTL_SECONDS=300
# Session state TTL in Redis; extend for longer conversational memory per key
HTH_SESSION_TTL_SECONDS=1800
HTH_DEFAULT_SESSION_ID=default

HTH_ENABLE_MOCK_UI_SIMULATION=true
HTH_MOCK_UI_PATH=./ui/mock/index.html
HTH_SERVER_LOGO_URL=/api/v1/chat/public/hth.jpeg
HTH_SERVER_WEBSITE_URL=/api/v1/chat

HTH_AGENT_MAX_STEPS=20
# Maximum concurrent Harmonise detail lookups per session (extras queue sequentially)
HTH_STOCK_PARALLEL_REQUESTS_LIMIT=100

# false = require Redis (persistent cache); true = allow in-memory only if Redis is unreachable
HTH_REDIS_FALLBACK_ENABLED=false
# Local `/api/v1/query` chat memory buffer (device-local process memory; never Redis)
HTH_LOCAL_CHAT_MEMORY_ENABLED=true
# Number of prior user+assistant turn pairs replayed to the model in local REST mode
HTH_LOCAL_CHAT_MEMORY_TURNS=3
HTH_MOCK_CATALOG_PATH=./mock/product-catalog.json
HTH_MOCK_DETAILS_PATH=./mock/product-details.json
HTH_MOCK_DEPARTMENTS_PATH=./mock/departments.json
HTH_MOCK_CATEGORIES_PATH=./mock/categories.json
